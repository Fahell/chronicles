{
  "name": "vn-rpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI visual-novel RPG for the Perchance platform (three.js + PixiJS + Preact).",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.21.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "analyze": "vite build --config vite.analyze.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:all": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@pixi/particle-emitter": "5.0.10",
    "@preact/signals": "2.11.0",
    "dexie": "4.4.4",
    "gpt-tokenizer": "3.4.0",
    "gsap": "3.15.0",
    "i18next": "26.3.6",
    "i18next-browser-languagedetector": "8.2.1",
    "i18next-resources-to-backend": "1.2.3",
    "pixi-filters": "6.1.5",
    "pixi.js": "8.19.0",
    "preact": "10.29.8",
    "seedrandom": "3.0.5",
    "three": "0.185.1",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "24.10.1",
    "@types/three": "0.185.0",
    "fake-indexeddb": "6.2.5",
    "rollup-plugin-visualizer": "7.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
