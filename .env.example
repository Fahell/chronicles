# Graphify — Gemini backend (semantic pass over docs).
# Copy this file to .env and fill in your values. Never commit real keys.
# Get a free key at https://aistudio.google.com/apikey

# Google AI Studio API key (starts with AIza...)
GEMINI_API_KEY=

# Gemini model override. Leave empty to use Graphify's default.
GRAPHIFY_GEMINI_MODEL=
